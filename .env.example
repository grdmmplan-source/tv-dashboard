# Senha obrigatória para salvar alterações no Admin
ADMIN_PASSWORD=coloque-uma-senha-forte-aqui

# Recomendado: Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternativa: Redis compatível com RESP
# REDIS_URL=redis://usuario:senha@host:6379

# Sem Redis configurado, a configuração fica em ./data/config.json
# CONFIG_FILE=./data/config.json
